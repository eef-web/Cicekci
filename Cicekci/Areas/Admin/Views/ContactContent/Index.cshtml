@model Cicekci.Models.SiteContent
@{
    ViewData["Title"] = "İletişim İçeriği";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-telephone"></i> İletişim İçeriği</h2>
    <a asp-action="Edit" class="btn btn-success"><i class="bi bi-pencil"></i> Düzenle</a>
</div>

<div class="card stat-card">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Adres</dt>
            <dd class="col-sm-9">@Model.ContactAddress</dd>

            <dt class="col-sm-3 text-muted">Telefon</dt>
            <dd class="col-sm-9">@Model.ContactPhone</dd>

            <dt class="col-sm-3 text-muted">E-posta</dt>
            <dd class="col-sm-9">@Model.ContactEmail</dd>

            <dt class="col-sm-3 text-muted">Çalışma Saatleri</dt>
            <dd class="col-sm-9">@Model.ContactWorkingHours</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a href="/Home/Contact" target="_blank" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-box-arrow-up-right"></i> İletişim Sayfasını Görüntüle
    </a>
</div>
