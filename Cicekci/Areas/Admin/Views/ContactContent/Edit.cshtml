@model Cicekci.Models.ContactContentViewModel
@{
    ViewData["Title"] = "İletişim İçeriğini Düzenle";
}

<h2 class="mb-4"><i class="bi bi-telephone"></i> İletişim İçeriğini Düzenle</h2>

<div class="card stat-card">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="ContactAddress" class="form-label"></label>
                <input asp-for="ContactAddress" class="form-control" />
                <span asp-validation-for="ContactAddress" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ContactPhone" class="form-label"></label>
                    <input asp-for="ContactPhone" class="form-control" />
                    <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ContactEmail" class="form-label"></label>
                    <input asp-for="ContactEmail" class="form-control" />
                    <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="ContactWorkingHours" class="form-label"></label>
                <input asp-for="ContactWorkingHours" class="form-control" />
                <span asp-validation-for="ContactWorkingHours" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </form>
    </div>
</div>
