@model Cicekci.Models.SiteContent
@{
    ViewData["Title"] = "Hakkımızda İçeriği";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-info-circle"></i> Hakkımızda İçeriği</h2>
    <a asp-action="Edit" class="btn btn-success"><i class="bi bi-pencil"></i> Düzenle</a>
</div>

<div class="card stat-card">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Başlık</dt>
            <dd class="col-sm-9">@Model.AboutTitle</dd>

            <dt class="col-sm-3 text-muted">Ana Metin</dt>
            <dd class="col-sm-9">@Model.AboutMainText</dd>

            <dt class="col-sm-3 text-muted">Detay Metin</dt>
            <dd class="col-sm-9">@Model.AboutDetailText</dd>

            <dt class="col-sm-3 text-muted">Yıllık Tecrübe</dt>
            <dd class="col-sm-9">@Model.StatYears</dd>

            <dt class="col-sm-3 text-muted">Mutlu Müşteri</dt>
            <dd class="col-sm-9">@Model.StatCustomers</dd>

            <dt class="col-sm-3 text-muted">Çiçek Çeşidi</dt>
            <dd class="col-sm-9">@Model.StatProducts</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a href="/Home/About" target="_blank" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-box-arrow-up-right"></i> Hakkımızda Sayfasını Görüntüle
    </a>
</div>
