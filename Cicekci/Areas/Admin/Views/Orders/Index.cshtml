@model IEnumerable<Cicekci.Models.Order>
@{
    ViewData["Title"] = "Siparişler";
    var statusCounts = ViewBag.StatusCounts as Dictionary<string, int>;
}

<h2 class="mb-4"><i class="bi bi-receipt"></i> Siparişler</h2>

<!-- Durum filtre kartları -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-action="Index" class="text-decoration-none">
            <div class="card stat-card p-3 @(string.IsNullOrEmpty(ViewBag.CurrentFilter as string) ? "border-primary" : "")">
                <div class="d-flex align-items-center">
                    <div class="text-primary"><i class="bi bi-bag-check fs-4"></i></div>
                    <div class="ms-3">
                        <div class="text-muted small">Tümü</div>
                        <div class="h5 mb-0">@Model.Count()</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    @if (statusCounts != null)
    {
        foreach (var sc in statusCounts)
        {
            var icon = sc.Key switch
            {
                "Hazırlanıyor" => "bi-clock",
                "Gönderildi" => "bi-truck",
                "Teslim Edildi" => "bi-check-circle",
                "İptal" => "bi-x-circle",
                _ => "bi-circle"
            };
            var color = sc.Key switch
            {
                "Hazırlanıyor" => "text-warning",
                "Gönderildi" => "text-info",
                "Teslim Edildi" => "text-success",
                "İptal" => "text-danger",
                _ => "text-muted"
            };
            <div class="col-md-3">
                <a asp-action="Index" asp-route-status="@sc.Key" class="text-decoration-none">
                    <div class="card stat-card p-3 @(ViewBag.CurrentFilter as string == sc.Key ? "border-primary" : "")">
                        <div class="d-flex align-items-center">
                            <div class="@color"><i class="bi @icon fs-4"></i></div>
                            <div class="ms-3">
                                <div class="text-muted small">@sc.Key</div>
                                <div class="h5 mb-0">@sc.Value</div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    }
</div>

<!-- Sipariş tablosu -->
<div class="card stat-card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Müşteri</th>
                            <th>Telefon</th>
                            <th>Ürün Sayısı</th>
                            <th>Tutar</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var badgeClass = order.Status switch
                            {
                                "Hazırlanıyor" => "bg-warning text-dark",
                                "Gönderildi" => "bg-info text-dark",
                                "Teslim Edildi" => "bg-success",
                                "İptal" => "bg-danger",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td><strong>#@order.Id</strong></td>
                                <td>@order.FullName</td>
                                <td class="text-muted">@order.Phone</td>
                                <td>@order.Items.Sum(i => i.Quantity) adet</td>
                                <td class="fw-semibold">@order.TotalAmount.ToString("N0") TL</td>
                                <td class="text-muted small">@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td><span class="badge @badgeClass">@order.Status</span></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@order.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                <h5 class="mt-3 text-muted">Henüz sipariş yok</h5>
                <p class="text-muted">Müşteriler sipariş verdikçe burada görünecek.</p>
            </div>
        }
    </div>
</div>
