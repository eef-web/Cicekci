@model Cicekci.Models.Order
@{
    ViewData["Title"] = $"Sipariş #{Model.Id}";
    var badgeClass = Model.Status switch
    {
        "Hazırlanıyor" => "bg-warning text-dark",
        "Gönderildi" => "bg-info text-dark",
        "Teslim Edildi" => "bg-success",
        "İptal" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-receipt"></i> Sipariş #@Model.Id</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Geri</a>
</div>

<div class="row g-4">
    <!-- Sol: Müşteri ve adres bilgileri -->
    <div class="col-lg-4">
        <div class="card stat-card mb-3">
            <div class="card-body p-4">
                <h6 class="mb-3 text-muted"><i class="bi bi-person"></i> Müşteri Bilgileri</h6>
                <p class="mb-2"><strong>Ad Soyad:</strong><br />@Model.FullName</p>
                <p class="mb-2"><strong>Telefon:</strong><br />@Model.Phone</p>
                <p class="mb-2"><strong>E-posta:</strong><br />@Model.Email</p>
            </div>
        </div>

        <div class="card stat-card mb-3">
            <div class="card-body p-4">
                <h6 class="mb-3 text-muted"><i class="bi bi-geo-alt"></i> Teslimat Adresi</h6>
                <p>@Model.Address</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Note))
        {
            <div class="card stat-card mb-3">
                <div class="card-body p-4">
                    <h6 class="mb-3 text-muted"><i class="bi bi-sticky"></i> Sipariş Notu</h6>
                    <p>@Model.Note</p>
                </div>
            </div>
        }

        <!-- Durum güncelleme -->
        <div class="card stat-card">
            <div class="card-body p-4">
                <h6 class="mb-3 text-muted"><i class="bi bi-flag"></i> Sipariş Durumu</h6>
                <div class="mb-3">
                    <span class="badge @badgeClass fs-6">@Model.Status</span>
                    <span class="text-muted small ms-2">@Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</span>
                </div>

                <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <select name="status" class="form-select form-select-sm">
                        <option value="Hazırlanıyor" selected="@(Model.Status == "Hazırlanıyor")">Hazırlanıyor</option>
                        <option value="Gönderildi" selected="@(Model.Status == "Gönderildi")">Gönderildi</option>
                        <option value="Teslim Edildi" selected="@(Model.Status == "Teslim Edildi")">Teslim Edildi</option>
                        <option value="İptal" selected="@(Model.Status == "İptal")">İptal</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg"></i></button>
                </form>
            </div>
        </div>
    </div>

    <!-- Sağ: Sipariş ürünleri ve toplam -->
    <div class="col-lg-8">
        <div class="card stat-card">
            <div class="card-body p-4">
                <h6 class="mb-3 text-muted"><i class="bi bi-bag"></i> Sipariş Edilen Ürünler</h6>

                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th class="text-center">Adet</th>
                            <th class="text-end">Birim Fiyat</th>
                            <th class="text-end">Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.Price.ToString("N0") TL</td>
                                <td class="text-end fw-semibold">@((item.Price * item.Quantity).ToString("N0")) TL</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Toplam:</td>
                            <td class="text-end fw-bold fs-5 text-success">@Model.TotalAmount.ToString("N0") TL</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Silme butonu -->
        <div class="mt-3">
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash"></i> Siparişi Sil
            </a>
        </div>
    </div>
</div>
