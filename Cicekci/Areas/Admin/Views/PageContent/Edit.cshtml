@model Cicekci.Models.SiteContent
@{
    ViewData["Title"] = "Site İçerikleri";
}

<h2 class="mb-4"><i class="bi bi-gear"></i> Site İçeriklerini Düzenle</h2>

<div class="card stat-card">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <h5 class="mb-3 text-success"><i class="bi bi-house"></i> Anasayfa</h5>
            <div class="mb-3">
                <label asp-for="HomeHeroTitle" class="form-label"></label>
                <input asp-for="HomeHeroTitle" class="form-control" />
                <span asp-validation-for="HomeHeroTitle" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HomeHeroSubtitle" class="form-label"></label>
                <input asp-for="HomeHeroSubtitle" class="form-control" />
                <span asp-validation-for="HomeHeroSubtitle" class="text-danger small"></span>
            </div>

            <hr class="my-4" />

            <h5 class="mb-3 text-success"><i class="bi bi-info-circle"></i> Hakkımızda</h5>
            <div class="mb-3">
                <label asp-for="AboutTitle" class="form-label"></label>
                <input asp-for="AboutTitle" class="form-control" />
                <span asp-validation-for="AboutTitle" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AboutMainText" class="form-label"></label>
                <textarea asp-for="AboutMainText" class="form-control" rows="3"></textarea>
                <span asp-validation-for="AboutMainText" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AboutDetailText" class="form-label"></label>
                <textarea asp-for="AboutDetailText" class="form-control" rows="4"></textarea>
                <span asp-validation-for="AboutDetailText" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="StatYears" class="form-label"></label>
                    <input asp-for="StatYears" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="StatCustomers" class="form-label"></label>
                    <input asp-for="StatCustomers" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="StatProducts" class="form-label"></label>
                    <input asp-for="StatProducts" class="form-control" />
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="mb-3 text-success"><i class="bi bi-telephone"></i> İletişim</h5>
            <div class="mb-3">
                <label asp-for="ContactAddress" class="form-label"></label>
                <input asp-for="ContactAddress" class="form-control" />
                <span asp-validation-for="ContactAddress" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ContactPhone" class="form-label"></label>
                    <input asp-for="ContactPhone" class="form-control" />
                    <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ContactEmail" class="form-label"></label>
                    <input asp-for="ContactEmail" class="form-control" />
                    <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="ContactWorkingHours" class="form-label"></label>
                <input asp-for="ContactWorkingHours" class="form-control" />
                <span asp-validation-for="ContactWorkingHours" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Kaydet</button>
        </form>
    </div>
</div>
