@model Cicekci.Models.Category
@{
    ViewData["Title"] = "Kategori Düzenle";
}

<h2 class="mb-4"><i class="bi bi-pencil"></i> Kategori Düzenle</h2>

<div class="card stat-card">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Güncelle</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </form>
    </div>
</div>
