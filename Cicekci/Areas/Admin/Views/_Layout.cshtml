<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Çiçekçi Yönetim Paneli</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body { background-color: #f8f9fa; }
        .sidebar { min-height: 100vh; background: #2d3a27; position: fixed; top: 0; left: 0; }
        .sidebar .nav-link { color: rgba(255,255,255,0.8); border-radius: 8px; padding: 10px 15px; margin-bottom: 4px; }
        .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,0.1); }
        .sidebar .nav-link.active { color: #fff; background: rgba(255,255,255,0.15); }
        .sidebar .nav-link i { width: 24px; }
        .sidebar .brand { color: #fff; font-size: 1.25rem; font-weight: 600; }
        .main-content { margin-left: 230px; padding: 24px; }
        .stat-card { border: none; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
        .stat-card .icon { font-size: 2rem; }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
    <!-- Sidebar -->
    <nav class="sidebar p-3 col-md-3 col-lg-2" style="width: 230px;">
        <div class="brand mb-4">
            <i class="bi bi-flower1"></i> Çiçekçi Admin
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Panel
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Products" asp-action="Index">
                    <i class="bi bi-bag"></i> Ürünler
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-tags"></i> Kategoriler
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index">
                    <i class="bi bi-envelope"></i> Mesajlar
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="PageContent" asp-action="Edit">
                    <i class="bi bi-gear"></i> Site İçerikleri
                </a>
            </li>
            <li class="nav-item mt-3 border-top pt-3">
                <a class="nav-link" href="/">
                    <i class="bi bi-house"></i> Siteye Dön
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-danger" asp-area="Admin" asp-controller="Account" asp-action="Logout">
                    <i class="bi bi-box-arrow-right"></i> Çıkış
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main content -->
    <div class="main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
