@using Cicekci.Models
@{
    ViewData["Title"] = "Yönetim Paneli";
    var productCount = ViewBag.ProductCount ?? 0;
    var categoryCount = ViewBag.CategoryCount ?? 0;
    var messageCount = ViewBag.MessageCount ?? 0;
    var unreadCount = ViewBag.UnreadMessageCount ?? 0;
    var outOfStock = ViewBag.OutOfStockCount ?? 0;
    var orderCount = ViewBag.OrderCount ?? 0;
    var pendingOrders = ViewBag.PendingOrderCount ?? 0;
    var revenue = (decimal)(ViewBag.Revenue ?? 0m);
    var recentMessages = ViewBag.RecentMessages as IEnumerable<ContactMessage>;
    var recentProducts = ViewBag.RecentProducts as IEnumerable<Product>;
    var recentOrders = ViewBag.RecentOrders as IEnumerable<Order>;
}

<h2 class="mb-4"><i class="bi bi-speedometer2"></i> Panel</h2>

<!-- İstatistik kartları -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-success"><i class="bi bi-bag"></i></div>
                <div class="ms-3">
                    <div class="text-muted small">Ürün</div>
                    <div class="h4 mb-0">@productCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-info"><i class="bi bi-tags"></i></div>
                <div class="ms-3">
                    <div class="text-muted small">Kategori</div>
                    <div class="h4 mb-0">@categoryCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-primary"><i class="bi bi-envelope"></i></div>
                <div class="ms-3">
                    <div class="text-muted small">Toplam Mesaj</div>
                    <div class="h4 mb-0">@messageCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-warning"><i class="bi bi-bell"></i></div>
                <div class="ms-3">
                    <div class="text-muted small">Okunmamış</div>
                    <div class="h4 mb-0">@unreadCount</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sipariş kartları -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-primary"><i class="bi bi-receipt"></i></div>
                <div class="ms-3">
                    <div class="text-muted small">Toplam Sipariş</div>
                    <div class="h4 mb-0">@orderCount</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-warning"><i class="bi bi-clock"></i></div>
                <div class="ms-3">
                    <div class="text-muted small">Hazırlanan Sipariş</div>
                    <div class="h4 mb-0">@pendingOrders</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-success"><i class="bi bi-cash-stack"></i></div>
                <div class="ms-3">
                    <div class="text-muted small">Toplam Ciro</div>
                    <div class="h4 mb-0">@revenue.ToString("N0") TL</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (outOfStock > 0)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i> @outOfStock adet ürün stokta yok!
    </div>
}

<!-- Son siparişler ve mesajlar -->
<div class="row g-4">
    <div class="col-md-6">
        <div class="card stat-card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-receipt"></i> Son Siparişler</h5>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-primary">Tümü</a>
            </div>
            <div class="card-body">
                @if (recentOrders != null && recentOrders.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var o in recentOrders)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>#@o.Id</strong> — @o.FullName
                                    <br /><small class="text-muted">@o.OrderDate.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                                <div class="text-end">
                                    <span class="fw-semibold">@o.TotalAmount.ToString("N0") TL</span>
                                    <br /><span class="badge bg-warning text-dark">@o.Status</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Sipariş yok.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card stat-card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-envelope"></i> Son Mesajlar</h5>
                <a asp-area="Admin" asp-controller="ContactMessages" asp-action="Index" class="btn btn-sm btn-outline-primary">Tümü</a>
            </div>
            <div class="card-body">
                @if (recentMessages != null && recentMessages.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var msg in recentMessages)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@msg.Name</strong>
                                    @if (!msg.IsRead)
                                    {
                                        <span class="badge bg-danger ms-1">Yeni</span>
                                    }
                                    <br /><small class="text-muted">@msg.Email</small>
                                </div>
                                <small class="text-muted">@msg.SentDate.ToString("dd.MM.yyyy")</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Mesaj yok.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Son eklenen ürünler -->
<div class="row g-4 mt-0">
    <div class="col-12">
        <div class="card stat-card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-bag"></i> Son Eklenen Ürünler</h5>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-primary">Tümü</a>
            </div>
            <div class="card-body">
                @if (recentProducts != null && recentProducts.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var p in recentProducts)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@p.Name</strong>
                                    <br /><small class="text-muted">@p.Price.ToString("N0") TL</small>
                                </div>
                                @if (p.InStock)
                                {
                                    <span class="badge bg-success">Stokta</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Tükendi</span>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Ürün yok.</p>
                }
            </div>
        </div>
    </div>
</div>
