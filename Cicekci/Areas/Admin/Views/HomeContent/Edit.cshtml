@model Cicekci.Models.HomeContentViewModel
@{
    ViewData["Title"] = "Anasayfa İçeriğini Düzenle";
}

<h2 class="mb-4"><i class="bi bi-house"></i> Anasayfa İçeriğini Düzenle</h2>

<div class="card stat-card">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="HomeHeroTitle" class="form-label"></label>
                <input asp-for="HomeHeroTitle" class="form-control" />
                <span asp-validation-for="HomeHeroTitle" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HomeHeroSubtitle" class="form-label"></label>
                <input asp-for="HomeHeroSubtitle" class="form-control" />
                <span asp-validation-for="HomeHeroSubtitle" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HomeHeroImageUrl" class="form-label"></label>
                <input asp-for="HomeHeroImageUrl" class="form-control" />
                <span asp-validation-for="HomeHeroImageUrl" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FeaturedTitle" class="form-label"></label>
                <input asp-for="FeaturedTitle" class="form-control" />
                <span asp-validation-for="FeaturedTitle" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="WhyTitle" class="form-label"></label>
                <input asp-for="WhyTitle" class="form-control" />
                <span asp-validation-for="WhyTitle" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Benefit1Title" class="form-label"></label>
                <input asp-for="Benefit1Title" class="form-control" />
                <span asp-validation-for="Benefit1Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Benefit1Description" class="form-label"></label>
                <input asp-for="Benefit1Description" class="form-control" />
                <span asp-validation-for="Benefit1Description" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Benefit2Title" class="form-label"></label>
                <input asp-for="Benefit2Title" class="form-control" />
                <span asp-validation-for="Benefit2Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Benefit2Description" class="form-label"></label>
                <input asp-for="Benefit2Description" class="form-control" />
                <span asp-validation-for="Benefit2Description" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Benefit3Title" class="form-label"></label>
                <input asp-for="Benefit3Title" class="form-control" />
                <span asp-validation-for="Benefit3Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Benefit3Description" class="form-label"></label>
                <input asp-for="Benefit3Description" class="form-control" />
                <span asp-validation-for="Benefit3Description" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Benefit4Title" class="form-label"></label>
                <input asp-for="Benefit4Title" class="form-control" />
                <span asp-validation-for="Benefit4Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Benefit4Description" class="form-label"></label>
                <input asp-for="Benefit4Description" class="form-control" />
                <span asp-validation-for="Benefit4Description" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </form>
    </div>
</div>
