@model List<Cicekci.Models.CartItem>
@{
    ViewData["Title"] = "Sepet";
    var total = ViewBag.Total ?? 0m;
}

<h2 class="fw-bold mb-4">Sepetim 🛒</h2>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-basket text-muted" style="font-size: 4rem;"></i>
        <p class="mt-3 text-muted">Sepetiniz boş.</p>
        <a href="/Products" class="btn btn-success">Ürünleri Gör</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ürün</th>
                    <th>Fiyat</th>
                    <th>Adet</th>
                    <th>Toplam</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" />
                            }
                            <span>@item.ProductName</span>
                        </td>
                        <td>@item.Price TL</td>
                        <td>
                            <form action="/Cart/Update" method="post" class="d-flex gap-1">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="0" class="form-control form-control-sm" style="width: 70px;" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Güncelle</button>
                            </form>
                        </td>
                        <td class="fw-bold">@(item.Price * item.Quantity) TL</td>
                        <td>
                            <a href="/Cart/Remove?productId=@item.ProductId" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <td colspan="3" class="text-end fw-bold">Genel Toplam:</td>
                    <td class="fw-bold text-success fs-5">@total TL</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex gap-2 mt-3">
        <a href="/Products" class="btn btn-outline-secondary">Alışverişe Devam Et</a>
        <a href="/Cart/Checkout" class="btn btn-success px-4">
            <i class="bi bi-check-circle"></i> Siparişi Tamamla
        </a>
    </div>
}
