@model IEnumerable<Cicekci.Models.CartItem>
@{
    ViewData["Title"] = "Sepetim";
    var total = ViewBag.Total as decimal? ?? 0m;
    var itemCount = ViewBag.ItemCount as int? ?? 0;
}

<section class="py-5" style="background: #f8f9fa; min-height: 80vh;">
    <div class="container">
        <h2 class="mb-4" style="color: #2d3a27;"><i class="bi bi-bag"></i> Sepetim</h2>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-bag-x" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3 text-muted">Sepetiniz boş</h4>
                <a href="/Products" class="btn btn-success mt-3">Çiçekleri Gör</a>
            </div>
        }
        else
        {
            <!-- Adım göstergesi -->
            <div class="d-flex align-items-center mb-4">
                <div class="d-flex align-items-center">
                    <span class="badge rounded-circle bg-success text-white" style="width: 32px; height: 32px;">1</span>
                    <span class="ms-2 fw-semibold text-success">Sepet</span>
                </div>
                <div class="flex-grow-1 mx-2" style="height: 2px; background: #dee2e6;"></div>
                <div class="d-flex align-items-center">
                    <span class="badge rounded-circle bg-light text-muted border" style="width: 32px; height: 32px;">2</span>
                    <span class="ms-2 text-muted">Teslimat Bilgileri</span>
                </div>
                <div class="flex-grow-1 mx-2" style="height: 2px; background: #dee2e6;"></div>
                <div class="d-flex align-items-center">
                    <span class="badge rounded-circle bg-light text-muted border" style="width: 32px; height: 32px;">3</span>
                    <span class="ms-2 text-muted">Onay</span>
                </div>
            </div>

            <div class="row g-4">
                <!-- Sol: Sepet ürünleri -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                        <div class="card-body p-4">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Görsel</th>
                                        <th>Ürün</th>
                                        <th>Fiyat</th>
                                        <th>Adet</th>
                                        <th>Tutar</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" />
                                                }
                                            </td>
                                            <td>@item.ProductName</td>
                                            <td>@item.Price.ToString("N0") TL</td>
                                            <td>
                                                <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" style="width: 70px;" onchange="this.form.submit()" />
                                                </form>
                                            </td>
                                            <td class="fw-bold">@((item.Price * item.Quantity).ToString("N0")) TL</td>
                                            <td>
                                                <a href="/Cart/Remove?productId=@item.ProductId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="d-flex justify-content-between mt-3">
                                <a href="/Cart/Clear" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Sepeti Boşalt</a>
                                <a href="/Products" class="btn btn-outline-success btn-sm"><i class="bi bi-arrow-left"></i> Alışverişe Devam Et</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sağ: Özet + Siparişi Onayla -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm" style="border-radius: 16px; position: sticky; top: 20px;">
                        <div class="card-body p-4">
                            <h5 class="mb-3" style="color: #2d3a27;">Sipariş Özeti</h5>

                            <div class="d-flex justify-content-between mb-2 text-muted">
                                <span>Ürün Adedi</span>
                                <span>@itemCount adet</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 text-muted">
                                <span>Ara Toplam</span>
                                <span>@total.ToString("N0") TL</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 text-muted">
                                <span>Teslimat</span>
                                <span class="text-success fw-semibold">Ücretsiz</span>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between mb-4">
                                <span class="fw-bold fs-5">Toplam</span>
                                <span class="fw-bold fs-5 text-success">@total.ToString("N0") TL</span>
                            </div>

                            <a href="/Cart/Checkout" class="btn btn-lg btn-success w-100 mb-2" style="background: #2d3a27; border-radius: 10px;">
                                <i class="bi bi-check-circle"></i> Siparişi Onayla
                            </a>

                            <div class="text-center mt-3">
                                <i class="bi bi-shield-check text-success"></i>
                                <small class="text-muted">Güvenli ödeme altyapısı</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
