@model Cicekci.Models.Order
@{
    ViewData["Title"] = "Teslimat Bilgileri";
    var total = ViewBag.Total as decimal? ?? 0m;
}

<section class="py-5" style="background: #f8f9fa; min-height: 80vh;">
    <div class="container">

        <!-- Adım göstergesi -->
        <div class="d-flex align-items-center mb-4">
            <div class="d-flex align-items-center">
                <span class="badge rounded-circle bg-light text-muted border" style="width: 32px; height: 32px;">
                    <i class="bi bi-check"></i>
                </span>
                <span class="ms-2 text-muted">Sepet</span>
            </div>
            <div class="flex-grow-1 mx-2" style="height: 2px; background: #dee2e6;"></div>
            <div class="d-flex align-items-center">
                <span class="badge rounded-circle bg-success text-white" style="width: 32px; height: 32px;">2</span>
                <span class="ms-2 fw-semibold text-success">Teslimat Bilgileri</span>
            </div>
            <div class="flex-grow-1 mx-2" style="height: 2px; background: #dee2e6;"></div>
            <div class="d-flex align-items-center">
                <span class="badge rounded-circle bg-light text-muted border" style="width: 32px; height: 32px;">3</span>
                <span class="ms-2 text-muted">Onay</span>
            </div>
        </div>

        <div class="row g-4">
            <!-- Sol: Teslimat formu -->
            <div class="col-lg-8">
                <form asp-action="Checkout" method="post">

                    <!-- Bölüm 1: Kişisel Bilgiler -->
                    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
                        <div class="card-body p-4">
                            <h5 class="mb-4" style="color: #2d3a27;">
                                <i class="bi bi-person-lines-fill me-2"></i>Kişisel Bilgiler
                            </h5>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                        <input asp-for="FullName" class="form-control" placeholder="Adınız Soyadınız" />
                                    </div>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                        <input asp-for="Phone" class="form-control" placeholder="+90 5xx xxx xx xx" />
                                    </div>
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Email" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                        <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bölüm 2: Teslimat Adresi -->
                    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
                        <div class="card-body p-4">
                            <h5 class="mb-4" style="color: #2d3a27;">
                                <i class="bi bi-geo-alt-fill me-2"></i>Teslimat Adresi
                            </h5>

                            <div class="mb-3">
                                <label asp-for="Address" class="form-label fw-semibold"></label>
                                <textarea asp-for="Address" class="form-control" rows="3"
                                          placeholder="Mahalle, Sokak, Bina No, Daire No, İlçe, İl"></textarea>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <!-- Sipariş Notu -->
                            <div class="mb-3">
                                <label asp-for="Note" class="form-label fw-semibold"></label>
                                <textarea asp-for="Note" class="form-control" rows="2"
                                          placeholder="Örn: Kapıcıya bırakın, zile basmayın, vb. (opsiyonel)"></textarea>
                                <span asp-validation-for="Note" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Bölüm 3: Ödeme Yöntemi (bilgilendirme amaçlı) -->
                    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
                        <div class="card-body p-4">
                            <h5 class="mb-4" style="color: #2d3a27;">
                                <i class="bi bi-credit-card-fill me-2"></i>Ödeme Yöntemi
                            </h5>

                            <div class="d-flex flex-column gap-2">
                                <label class="d-flex align-items-center p-3 rounded-3 border" style="cursor: pointer; background: #f8f9fa;">
                                    <input type="radio" name="paymentMethod" value="kapida" checked />
                                    <i class="bi bi-cash-coin mx-3 fs-5 text-success"></i>
                                    <div>
                                        <span class="fw-semibold">Kapıda Ödeme (Nakit)</span>
                                        <br />
                                        <small class="text-muted">Sipariş tesliminde ödeme yapın</small>
                                    </div>
                                </label>

                                <label class="d-flex align-items-center p-3 rounded-3 border" style="cursor: pointer; background: #f8f9fa;">
                                    <input type="radio" name="paymentMethod" value="havale" />
                                    <i class="bi bi-bank mx-3 fs-5 text-primary"></i>
                                    <div>
                                        <span class="fw-semibold">Havale / EFT</span>
                                        <br />
                                        <small class="text-muted">Banka transferi ile ödeme yapın</small>
                                    </div>
                                </label>
                            </div>

                            <div class="mt-3 p-3 rounded-3 d-flex align-items-center" style="background: #fff8e1;">
                                <i class="bi bi-shield-check text-warning me-2 fs-5"></i>
                                <small class="text-muted">Siparişiniz alındıktan sonra ödeme talimatları e-posta ile iletilecektir.</small>
                            </div>
                        </div>
                    </div>

                    <!-- Butonlar -->
                    <div class="d-flex justify-content-between">
                        <a href="/Cart" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left"></i> Sepete Dön</a>
                        <button type="submit" class="btn btn-lg text-white px-5" style="background: #2d3a27; border-radius: 10px;">
                            <i class="bi bi-check-circle"></i> Siparişi Tamamla
                        </button>
                    </div>

                </form>
            </div>

            <!-- Sağ: Sipariş Özeti -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm" style="border-radius: 16px; position: sticky; top: 20px;">
                    <div class="card-body p-4">
                        <h5 class="mb-3" style="color: #2d3a27;">Sipariş Özeti</h5>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Ürünler Toplamı</span>
                            <span class="fw-semibold">@total.ToString("N0") TL</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Teslimat Ücreti</span>
                            <span class="text-success fw-semibold">Ücretsiz</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-bold fs-5">Toplam</span>
                            <span class="fw-bold fs-5" style="color: #2d3a27;">@total.ToString("N0") TL</span>
                        </div>

                        <!-- Güvenlik bilgileri -->
                        <div class="d-flex align-items-center justify-content-center mb-2 p-2 rounded" style="background: #f0f8f0;">
                            <i class="bi bi-shield-lock-fill text-success me-2"></i>
                            <small class="text-muted">256-bit SSL ile güvenli ödeme</small>
                        </div>
                        <div class="d-flex align-items-center justify-content-center mb-2 p-2 rounded" style="background: #f0f8f0;">
                            <i class="bi bi-clock-history text-success me-2"></i>
                            <small class="text-muted">Aynı gün teslimat (17:00'den önceki siparişler)</small>
                        </div>
                        <div class="d-flex align-items-center justify-content-center p-2 rounded" style="background: #f0f8f0;">
                            <i class="bi bi-arrow-repeat text-success me-2"></i>
                            <small class="text-muted">Memnuniyet garantisi</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
