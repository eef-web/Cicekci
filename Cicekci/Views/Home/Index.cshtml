@model List<Cicekci.Models.Product>
@{
    ViewData["Title"] = "Ana Sayfa";
    var categories = (List<Cicekci.Models.Category>)ViewBag.Categories ?? new List<Cicekci.Models.Category>();
}

<!-- Hero Banner -->
<div class="hero-section text-center mb-5">
    <div class="hero-overlay">
        <h1 class="display-4 fw-bold text-white">Sevdiklerinize Çiçek Gönderin 🌸</h1>
        <p class="lead text-white-50">Taze çiçekler, hızlı teslimat, mutlu yüzler.</p>
        <a href="/Products" class="btn btn-light btn-lg mt-3">Ürünleri Gör</a>
    </div>
</div>

<!-- Kategoriler -->
<div class="mb-5">
    <h3 class="mb-3">Kategoriler</h3>
    <div class="row g-3">
        @foreach (var cat in categories)
        {
            <div class="col-md-3 col-sm-6">
                <a href="/Products?categoryId=@cat.Id" class="text-decoration-none">
                    <div class="card category-card h-100">
                        <div class="card-body text-center">
                            <i class="bi bi-flower2 fs-1 text-success"></i>
                            <h5 class="mt-2">@cat.Name</h5>
                            <p class="small text-muted">@cat.Description</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<!-- Öne Çıkan Ürünler -->
<div>
    <h3 class="mb-3">Öne Çıkan Ürünler</h3>
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-lg-3 col-md-6">
                <div class="card product-card h-100">
                    <img src="@(p.ImageUrl ?? "https://via.placeholder.com/600")" class="card-img-top product-img" alt="@p.Name" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@p.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@(p.Description.Length > 60 ? p.Description.Substring(0, 60) + "..." : p.Description)</p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="price-tag">@p.Price TL</span>
                            <a href="/Products/Details/@p.Id" class="btn btn-sm btn-outline-success">Detay</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
