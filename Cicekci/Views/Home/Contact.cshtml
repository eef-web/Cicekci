@model Cicekci.Models.ContactMessage
@{
    ViewData["Title"] = "İletişim";
    var content = ViewBag.Content as Cicekci.Models.SiteContent ?? new Cicekci.Models.SiteContent();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="py-5">
    <div class="container">
        <h2 class="text-center mb-5" style="color: #2d3a27;">İletişim</h2>
        <div class="row g-4">
            <!-- İletişim Bilgileri -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                    <div class="card-body p-4">
                        <h4 class="mb-4" style="color: #2d3a27;">Bize Ulaşın</h4>
                        <div class="d-flex mb-3">
                            <i class="bi bi-geo-alt-fill me-3" style="font-size: 1.5rem; color: #2d3a27;"></i>
                            <div>
                                <strong>Adres</strong>
                                <p class="text-muted mb-0">@content.ContactAddress</p>
                            </div>
                        </div>
                        <div class="d-flex mb-3">
                            <i class="bi bi-telephone-fill me-3" style="font-size: 1.5rem; color: #2d3a27;"></i>
                            <div>
                                <strong>Telefon</strong>
                                <p class="text-muted mb-0">@content.ContactPhone</p>
                            </div>
                        </div>
                        <div class="d-flex mb-3">
                            <i class="bi bi-envelope-fill me-3" style="font-size: 1.5rem; color: #2d3a27;"></i>
                            <div>
                                <strong>E-posta</strong>
                                <p class="text-muted mb-0">@content.ContactEmail</p>
                            </div>
                        </div>
                        <div class="d-flex">
                            <i class="bi bi-clock-fill me-3" style="font-size: 1.5rem; color: #2d3a27;"></i>
                            <div>
                                <strong>Çalışma Saatleri</strong>
                                <p class="text-muted mb-0">@content.ContactWorkingHours</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- İletişim Formu -->
            <div class="col-md-7">
                <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                    <div class="card-body p-4">
                        <h4 class="mb-4" style="color: #2d3a27;">Mesaj Gönderin</h4>
                        <form asp-action="Contact" method="post">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Name" class="form-label"></label>
                                    <input asp-for="Name" class="form-control" />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Phone" class="form-label"></label>
                                    <input asp-for="Phone" class="form-control" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Message" class="form-label"></label>
                                <textarea asp-for="Message" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Message" class="text-danger small"></span>
                            </div>
                            <button type="submit" class="btn text-white" style="background: #2d3a27; border-radius: 10px;">
                                <i class="bi bi-send"></i> Gönder
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
