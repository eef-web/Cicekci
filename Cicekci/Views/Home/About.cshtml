@model Cicekci.Models.SiteContent
@{
    ViewData["Title"] = "Hakkımızda";
}

<section class="py-5" style="background: #f8f9fa;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1520763185298-1b58670fba46?w=800" class="img-fluid rounded shadow" style="border-radius: 16px;" />
            </div>
            <div class="col-md-6 mt-4 mt-md-0">
                <h2 style="color: #2d3a27;">@Model.AboutTitle</h2>
                <p class="lead mt-3">@Model.AboutMainText</p>
                <p class="text-muted">@Model.AboutDetailText</p>
            </div>
        </div>
    </div>
</section>

<section class="py-5 text-white text-center" style="background: #2d3a27;">
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <h2 class="fw-bold">@Model.StatYears</h2>
                <p>Yıllık Tecrübe</p>
            </div>
            <div class="col-md-4">
                <h2 class="fw-bold">@Model.StatCustomers</h2>
                <p>Mutlu Müşteri</p>
            </div>
            <div class="col-md-4">
                <h2 class="fw-bold">@Model.StatProducts</h2>
                <p>Çiçek Çeşidi</p>
            </div>
        </div>
    </div>
</section>
