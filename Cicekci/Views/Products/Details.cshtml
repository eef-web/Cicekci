@model Cicekci.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<section class="py-5" style="background: #f8f9fa; min-height: 80vh;">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid shadow" style="border-radius: 16px; width: 100%;" />
                }
            </div>
            <div class="col-md-6">
                <h2 style="color: #2d3a27;">@Model.Name</h2>
                @if (Model.Category != null)
                {
                    <span class="badge bg-info mb-3">@Model.Category.Name</span>
                }
                <p class="lead mt-3">@Model.Description</p>

                <div class="d-flex align-items-center mt-4">
                    <span class="display-6 fw-bold me-3" style="color: #2d3a27;">@Model.Price.ToString("N0") TL</span>
                    @if (Model.InStock)
                    {
                        <span class="badge bg-success">Stokta Var</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Tükendi</span>
                    }
                </div>

                @if (Model.InStock)
                {
                    <a href="/Cart/Add?productId=@Model.Id" class="btn btn-lg text-white mt-4" style="background: #2d3a27; border-radius: 10px;">
                        <i class="bi bi-bag-plus"></i> Sepete Ekle
                    </a>
                }

                <a href="/Products" class="btn btn-outline-secondary mt-4 ms-2">Geri</a>
            </div>
        </div>
    </div>
</section>
