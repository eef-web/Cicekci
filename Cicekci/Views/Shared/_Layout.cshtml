<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Çiçekçi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background: #2d3a27;">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-flower1"></i> Çiçekçi
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navContent">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Anasayfa</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Products">Ürünler</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/About">Hakkımızda</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Contact">İletişim</a></li>
                </ul>
                <div class="d-flex align-items-center">
                    <a href="/Cart" class="btn btn-outline-light btn-sm me-2">
                        <i class="bi bi-bag"></i> Sepet
                    </a>
                    <a href="/Admin/Account/Login" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-gear"></i> Yönetim
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="text-white py-4 mt-5" style="background: #2d3a27;">
        <div class="container text-center">
            <p class="mb-0"><i class="bi bi-flower1"></i> Çiçekçi &copy; 2025 - Tüm hakları saklıdır.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
